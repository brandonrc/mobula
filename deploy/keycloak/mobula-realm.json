{
  "realm": "mobula",
  "enabled": true,
  "displayName": "Mobula local auth demo",
  "sslRequired": "none",
  "groups": [
    {
      "name": "platform-admins"
    },
    {
      "name": "sre"
    },
    {
      "name": "ml-eng"
    },
    {
      "name": "observers"
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@mobula.local",
      "firstName": "Ada",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "groups": [
        "/platform-admins"
      ]
    },
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "email": "operator@mobula.local",
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ],
      "groups": [
        "/sre"
      ],
      "firstName": "Operator",
      "lastName": "Demo"
    },
    {
      "username": "developer",
      "enabled": true,
      "emailVerified": true,
      "email": "developer@mobula.local",
      "credentials": [
        {
          "type": "password",
          "value": "developer",
          "temporary": false
        }
      ],
      "groups": [
        "/ml-eng"
      ],
      "firstName": "Developer",
      "lastName": "Demo"
    },
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "email": "viewer@mobula.local",
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "groups": [
        "/observers"
      ],
      "firstName": "Viewer",
      "lastName": "Demo"
    },
    {
      "username": "service-account-mobula-service",
      "enabled": true,
      "serviceAccountClientId": "mobula-service",
      "groups": [
        "/ml-eng"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "mobula",
      "name": "Mobula control plane (humans)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8088/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:8088",
        "http://localhost:5173"
      ],
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "aud-mobula",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mobula",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mobula-service",
      "name": "Mobula service accounts (client-credentials)",
      "publicClient": false,
      "secret": "mobula-service-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "full.path": "true",
            "claim.name": "groups",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "aud-mobula",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "mobula",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
