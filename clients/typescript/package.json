{
  "name": "@brandonrc/mobula-client",
  "version": "0.0.1",
  "description": "Generated TypeScript client for the Mobula control-plane API — source of truth is mobula's openapi.json.",
  "license": "Apache-2.0",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": ["dist", "openapi.json"],
  "repository": {
    "type": "git",
    "url": "https://github.com/brandonrc/mobula.git",
    "directory": "clients/typescript"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "generate": "openapi-typescript ../../openapi.json -o src/schema.d.ts",
    "build": "npm run generate && tsc"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.7.0",
    "typescript": "~5.8.3"
  }
}
